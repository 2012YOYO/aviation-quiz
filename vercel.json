{
  "functions": {
    "server.js": {
      "runtime": "@vercel/node"
    }
  },
  "rewrites": [
    { "source": "/send-sms", "destination": "/server.js" },
    { "source": "/verify-sms", "destination": "/server.js" },
    { "source": "/status", "destination": "/server.js" },
    { "source": "/api/(.*)", "destination": "/server.js" },
    { "source": "/((?!server\\.js).*)", "destination": "/aviation_quiz.html" }
  ]
}
